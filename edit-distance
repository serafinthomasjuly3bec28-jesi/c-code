int minDistance(char* word1, char* word2) {
    int m = strlen(word1);
    int n = strlen(word2);

    // dp[i][j] = minimum operations to convert
    // first i chars of word1 into first j chars of word2
    int dp[m + 1][n + 1];

    // Convert word1[0..i-1] to empty string
    for (int i = 0; i <= m; i++)
        dp[i][0] = i;

    // Convert empty string to word2[0..j-1]
    for (int j = 0; j <= n; j++)
        dp[0][j] = j;

    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {

            if (word1[i - 1] == word2[j - 1]) {
                // Characters already match
                dp[i][j] = dp[i - 1][j - 1];
            } else {
                // 1 + minimum of:
                // delete, insert, replace
                int delete = dp[i - 1][j];
                int insert = dp[i][j - 1];
                int replace = dp[i - 1][j - 1];

                int min = delete < insert ? delete : insert;
                if (replace < min)
                    min = replace;

                dp[i][j] = 1 + min;
            }
        }
    }

    return dp[m][n];
}
