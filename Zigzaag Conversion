#include <string>
#include <vector>
#include <numeric>

class Solution {
public:
    std::string convert(std::string s, int numRows) {
        // Edge cases: no zigzag pattern is possible
        if (numRows == 1 || numRows >= s.length()) {
            return s;
        }
        
        std::vector<std::string> rows(std::min(numRows, (int)s.length()));
        int current_row = 0;
        bool going_down = false;
        
        for (char c : s) {
            rows[current_row] += c;
            
            // Flip direction at the top or bottom row boundary
            if (current_row == 0 || current_row == numRows - 1) {
                going_down = !going_down;
            }
            
            // Move up or down
            current_row += going_down ? 1 : -1;
        }
        
        // Combine all rows into a single string
        std::string result;
        for (const std::string& row : rows) {
            result += row;
        }
        
        return result;
    }
};
